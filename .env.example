# Production (Tencent EdgeOne Pages server-side environment variables)
# Never prefix these with VITE_ in production so they stay hidden from the browser.
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shared secret sent by Edge Functions (`_secret`) and verified by Code.gs (`EDGE_SHARED_SECRET` Script Property)
# to ensure write and contact-lookup requests originate from the Edge proxy.
EDGE_SHARED_SECRET=replace_with_a_long_random_secret_string

# Server-side salt used by Edge Functions to derive privacy-preserving per-IP rate-limit keys (`_ip`).
RATE_LIMIT_SALT=replace_with_a_random_rate_limit_salt

# Local development fallback ONLY (used by src/api.js when running `npm run dev` locally)
# Leave empty or unset in production builds.
VITE_GAS_URL=

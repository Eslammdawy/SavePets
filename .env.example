# Production (Tencent EdgeOne Pages server-side environment variable)
# Never prefix this with VITE_ in production so it stays hidden from the browser.
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Local development fallback ONLY (used by src/api.js when running `npm run dev` locally)
# Leave empty or unset in production builds.
VITE_GAS_URL=
